import { Stagehand, AISdkClient } from "@browserbasehq/stagehand";
import { createOpenAI } from "@ai-sdk/openai";
import { execSync } from "child_process";

async function main() {
  // Step 1: Call Python script to get token + base URL
  // Assumes get_creds.py prints JSON like: {"access_token": "...", "base_url": "..."}
  const output = execSync("python get_creds.py").toString();
  const { access_token, base_url } = JSON.parse(output);

  // Step 2: Create OpenAI-compatible provider pointing to your gateway
  const openaiProvider = createOpenAI({
    apiKey: access_token,
    baseURL: base_url,
  });

  // Step 3: Wrap in AISdkClient
  const llmClient = new AISdkClient({
    model: openaiProvider("us.anthropic.claude-sonnet-4-6"),
  });

  // Step 4: Configure Stagehand
  const stagehand = new Stagehand({
    env: "LOCAL",
    verbose: 1,
    llmClient,
  });

  // Step 5: Launch browser
  await stagehand.init();
  const page = stagehand.page;

  // Step 6: Open Google and search
  await page.goto("https://www.google.com");
  await page.act("Search for dogs");

  const title = await page.title();
  console.log("Page title:", title);
  console.log("Stagehand test completed successfully");

  await stagehand.close();
}

main().catch((err) => {
  console.error("Error:", err);
});
