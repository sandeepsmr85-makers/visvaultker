        print("-" * 40)
        for word, count in stats["most_common_words"]:
            print(f"  {word:20}: {count}")
    
    # HTML Structure
    structure = r["html_structure"]
    print("\nHTML STRUCTURE")
    print("-" * 40)
    
    structure_items = [
        ("Paragraphs", structure["paragraphs"]),
        ("Bold Text", structure["bold"]),
        ("Italic Text", structure["italic"]),
        ("Underlined Text", structure["underline"]),
        ("Links", structure["links"]),
        ("Images", structure["images"]),
        ("Tables", structure["tables"]),
        ("Divs", structure["divs"]),
