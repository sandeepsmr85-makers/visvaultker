    print(f"    Ordered  : {structure['lists']['ordered']}")
    print(f"    Items    : {structure['lists']['list_items']}")
    
    # Tables
    if r["tables"]:
        print("\nTABLES")
        print("-" * 40)
        for table in r["tables"]:
            print(f"\n  Table {table['table_number']}:")
            print(f"    Size: {table['rows']} rows × {table['columns']} columns")
            print(f"    Total Cells: {table['cells']}")
            print(f"    Non-empty Cells: {table['non_empty_cells']}")
            print(f"    Has Header: {'YES' if table['has_header'] else 'NO'}")
            
