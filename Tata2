# app/core/exceptions.py
"""
Complete exception hierarchy for the platform.
"""
class PlatformError(Exception):
    """Base exception for platform errors."""
    def __init__(self, message: str, details: Dict = None):
        super().__init__(message)
        self.details = details or {}

class ParsingError(PlatformError):
    """Raised when RFC 822 parsing fails."""
    pass

class InnerEmailDetectionError(PlatformError):
    """Raised when inner email detection fails."""
    pass

class RecipientMappingError(PlatformError):
    """Raised when recipient mapping fails."""
    pass

class DateTransformationError(PlatformError):
    """Raised when date transformation fails."""
    pass

class GenerationError(PlatformError):
    """Raised when content generation fails."""
    pass

class ValidationError(PlatformError):
    """Raised when validation fails."""
    def __init__(self, message: str, validation_type: str = "GENERAL", 
                 checks: Dict = None):
        super().__init__(message)
        self.validation_type = validation_type
        self.checks = checks or {}

class TypoGenerationError(PlatformError):
    """Raised when typo generation fails."""
    pass

class ReconstructionError(PlatformError):
    """Raised when RFC 822 reconstruction fails."""
    pass

class ConfigurationError(PlatformError):
    """Raised when configuration is invalid."""
    pass

class SourceIntegrityError(PlatformError):
    """Raised when source file integrity is compromised."""
    pass

class TemplateNotFoundError(PlatformError):
    """Raised when no templates are found."""
    pass

class RecipientPoolError(PlatformError):
    """Raised when recipient pool issues occur."""
    pass


