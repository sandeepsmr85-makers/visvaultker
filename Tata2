"""
Complete inner email detection with multiple strategies.
"""
from email.message import EmailMessage, MIMEPart
from typing import Optional, Tuple, Dict, Any, List
import re
import logging
from ..core.exceptions import InnerEmailDetectionError

logger = logging.getLogger(__name__)

class InnerEmailDetector:
    """
    Detects inner/original emails using multiple detection strategies.
    
    Rule 1: INNER EMAIL PRESENT → ALWAYS PROCESS THE INNER EMAIL
    Rule 2: INNER EMAIL ABSENT → PROCESS THE OUTER EMAIL
    """
    
    def __init__(self):
        self.detection_strategies = [
            self._detect_message_rfc822,
            self._detect_forwarded_content,
            self._detect_quoted_email,
            self._detect_journal_format
        ]
    
    def detect(self, msg: EmailMessage) -> Tuple[EmailMessage, bool, Dict[str, Any]]:
        """
        Detect inner email in message.
        
        Returns:
            Tuple of (target_message, is_inner, metadata)
        """
        metadata = {
            'has_inner': False,
            'detection_method': None,
            'inner_depth': 0,
            'outer_headers_preserved': True,
            'detection_confidence': 0.0
        }
        
        # Try each detection strategy
        for strategy in self.detection_strategies:
            inner, found, confidence = strategy(msg)
            if found and inner is not None:
                metadata['has_inner'] = True
                metadata['detection_method'] = strategy.__name__
                metadata['detection_confidence'] = confidence
                return inner, True, metadata
        
        # No inner email found
        return msg, False, metadata
    
    def select_target(self, msg: EmailMessage) -> Tuple[EmailMessage, bool]:
        """Select processing target per Rule 1."""
        target, is_inner, _ = self.detect(msg)
        return target, is_inner
    
    def _detect_message_rfc822(self, msg: EmailMessage) -> Tuple[Optional[EmailMessage], bool, float]:
        """Detect message/rfc822 parts (highest confidence)."""
        if not msg.is_multipart():
            return None, False, 0.0
        
        for part in msg.iter_parts():
            if part.get_content_type() == "message/rfc822":
                inner = self._extract_inner_from_part(part)
                if inner is not None:
                    return inner, True, 1.0
        
        return None, False, 0.0
    
    def _detect_forwarded_content(self, msg: EmailMessage) -> Tuple[Optional[EmailMessage], bool, float]:
        """Detect forwarded email content."""
        subject = msg.get('Subject', '')
        if not subject.lower().startswith(('fw:', 'fwd:', 'forward:')):
            return None, False, 0.0
        
        # Look for email headers in body
        body_text = self._extract_body_text(msg)
        if not body_text:
            return None, False, 0.0
        
        # Check for forwarded email indicators
        if self._contains_email_headers(body_text):
            reconstructed = self._reconstruct_from_text(body_text)
            if reconstructed:
                return reconstructed, True, 0.8
        
        return None, False, 0.0
    
    def _detect_quoted_email(self, msg: EmailMessage) -> Tuple[Optional[EmailMessage], bool, float]:
        """Detect quoted email content in replies."""
        body_text = self._extract_body_text(msg)
        if not body_text:
            return None, False, 0.0
        
        # Look for quoted email patterns
        lines = body_text.split('\n')
        quoted_lines = [l for l in lines if l.startswith('>')]
        
        if len(quoted_lines) > 3:
            # Check if quoted content contains email headers
            quoted_text = '\n'.join(l.lstrip('> ') for l in quoted_lines)
            if self._contains_email_headers(quoted_text):
                reconstructed = self._reconstruct_from_text(quoted_text)
                if reconstructed:
                    return reconstructed, True, 0.6
        
        return None, False, 0.0
    
    def _detect_journal_format(self, msg: EmailMessage) -> Tuple[Optional[EmailMessage], bool, float]:
        """Detect journal/envelope format with embedded email."""
        # Check for journal-specific headers
        journal_headers = ['X-Journal', 'X-Envelope', 'X-Transport']
        has_journal_header = any(h in msg for h in journal_headers)
        
        if not has_journal_header:
            return None, False, 0.0
        
        # Check body for embedded email
        body_text = self._extract_body_text(msg)
        if body_text and self._contains_email_headers(body_text):
            reconstructed = self._reconstruct_from_text(body_text)
            if reconstructed:
                return reconstructed, True, 0.7
        
        return None, False, 0.0
    
    def _extract_inner_from_part(self, part: MIMEPart) -> Optional[EmailMessage]:
        """Extract inner email from message/rfc822 part."""
        try:
            payload = part.get_payload()
            if isinstance(payload, list) and payload:
                return payload[0]
            elif isinstance(payload, EmailMessage):
                return payload
            elif isinstance(payload, str):
                # Parse string content
                from email.parser import BytesParser
                from email import policy
                parser = BytesParser(policy=policy.default)
                return parser.parsebytes(payload.encode('utf-8'))
        except Exception as e:
            logger.warning(f"Failed to extract inner email from part: {e}")
        return None
    
    def _extract_body_text(self, msg: EmailMessage) -> str:
        """Extract text from message body."""
        texts = []
        
        def _walk(part):
            if part.is_multipart():
                for sub_part in part.iter_parts():
                    _walk(sub_part)
            else:
                if part.get_content_type() == 'text/plain':
                    try:
                        texts.append(part.get_content())
                    except Exception:
                        pass
                elif part.get_content_type() == 'text/html':
                    try:
                        from bs4 import BeautifulSoup
                        soup = BeautifulSoup(part.get_content(), 'lxml')
                        texts.append(soup.get_text())
                    except Exception:
                        pass
        
        _walk(msg)
        return '\n'.join(texts)
    
    def _contains_email_headers(self, text: str) -> bool:
        """Check if text contains email headers."""
        patterns = [
            r'^From:',
            r'^To:',
            r'^Subject:',
            r'^Date:',
            r'^Message-ID:'
        ]
        
        lines = text.split('\n')
        found_headers = 0
        
        for line in lines:
            for pattern in patterns:
                if re.match(pattern, line, re.IGNORECASE):
                    found_headers += 1
                    break
        
        # Need at least 3 headers to be confident
        return found_headers >= 3
    
    def _reconstruct_from_text(self, text: str) -> Optional[EmailMessage]:
        """Reconstruct email from text content."""
        try:
            from email.parser import BytesParser
            from email import policy
            
            # Clean up the text
            clean_text = text.strip()
            
            # Try to parse as complete email
            parser = BytesParser(policy=policy.default)
            return parser.parsebytes(clean_text.encode('utf-8'))
        except Exception as e:
            logger.debug(f"Failed to reconstruct email from text: {e}")
            return None


