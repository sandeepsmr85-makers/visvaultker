@dataclass
class Settings:
    project_name: str = "synthetic-rfc822-platform"
    version: str = "7.0.0"
    
    template_directory: Path = Path("./templates")
    recipient_file: Path = Path("./input/recipients.txt")
    alert_concepts_file: Path = Path("./input/alert_concepts.txt")
    output_directory: Path = Path("./generated_dataset")
    ground_truth_directory: Path = Path("./ground_truth")
    manifest_file: Path = Path("./generated_dataset/manifest.json")
    behaviors_file: Path = Path("./config/behaviors.yaml")
    log_directory: Path = Path("./logs")
    
    generation: GenerationConfig = field(default_factory=GenerationConfig)
    preservation: PreservationConfig = field(default_factory=PreservationConfig)
    llm: LLMConfig = field(default_factory=LLMConfig)
    validation: ValidationConfig = field(default_factory=ValidationConfig)
    
    random_seed: Optional[int] = None
    
    def load_yaml(self, path: Path) -> None:
        if not path.exists():
            logger.warning(f"Config file not found: {path}")
            return
        
        try:
            with open(path, 'r') as f:
                data = yaml.safe_load(f) or {}
            
            for section, values in data.items():
                if section == 'generation' and isinstance(values, dict):
                    self._update_dataclass(self.generation, values)
                elif section == 'preservation' and isinstance(values, dict):
                    self._update_dataclass(self.preservation, values)
                elif section == 'llm' and isinstance(values, dict):
                    self._update_dataclass(self.llm, values)
                elif section == 'validation' and isinstance(values, dict):
                    self._update_dataclass(self.validation, values)
                elif hasattr(self, section):
                    if section in ['template_directory', 'recipient_file', 
                                  'alert_concepts_file', 'output_directory',
                                  'ground_truth_directory', 'manifest_file',
                                  'behaviors_file', 'log_directory']:
                        values = Path(values)
                    setattr(self, section, values)
        except Exception as e:
            logger.error(f"Failed to load config: {e}")
            raise
    
    def _update_dataclass(self, obj, values: Dict) -> None:
        for key, value in values.items():
            if hasattr(obj, key):
                if key == 'difficulty' and not isinstance(value, Difficulty):
                    obj.difficulty = Difficulty(str(value).upper())
                elif key == 'typo_intensity' and not isinstance(value, TypoIntensity):
                    obj.typo_intensity = TypoIntensity(str(value).upper())
                else:
                    setattr(obj, key, value)
    
    def ensure_directories(self) -> None:
        for dir_path in [self.template_directory, self.output_directory,
                        self.ground_truth_directory, self.log_directory]:
            dir_path.mkdir(parents=True, exist_ok=True)
        
        self.recipient_file.parent.mkdir(parents=True, exist_ok=True)
        self.alert_concepts_file.parent.mkdir(parents=True, exist_ok=True)
        self.behaviors_file.parent.mkdir(parents=True, exist_ok=True)
        
        if not self.recipient_file.exists():
