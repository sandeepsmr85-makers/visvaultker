class Difficulty(str, Enum):
    EASY = "EASY"
    MEDIUM = "MEDIUM"
    HARD = "HARD"
    VERY_HARD = "VERY_HARD"
    MIXED = "MIXED"

class TypoIntensity(str, Enum):
    LIGHT = "LIGHT"
    MEDIUM = "MEDIUM"
    HEAVY = "HEAVY"

class SemanticVariation(str, Enum):
    EXACT = "EXACT"
    SYNONYM = "SYNONYM"
    PARAPHRASE = "PARAPHRASE"
    INDIRECT = "INDIRECT"
    CONTEXTUAL = "CONTEXTUAL"
    MIXED = "MIXED"

