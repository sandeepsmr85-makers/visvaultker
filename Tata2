"""
Complete RFC 822 reconstruction with structure preservation.
"""
from email.message import EmailMessage, MIMEPart
from email import policy
from typing import Dict, List, Optional, Any, Tuple
import copy
import logging
from bs4 import BeautifulSoup
from ..core.exceptions import ReconstructionError

logger = logging.getLogger(__name__)

class RFC822Reconstructor:
    """
    Reconstructs RFC 822 messages while preserving structure.
    
    Key principle: Never serialize a new simplified email from scratch.
    Always clone and modify the existing tree.
    """
    
    def reconstruct(self, source: EmailMessage, target: EmailMessage,
                    generated_body: Dict[str, str],
                    recipient_mapping: Dict[str, str],
                    date_transformer) -> EmailMessage:
        """
        Reconstruct message with new content while preserving structure.
        """
        # Deep clone the source
        reconstructed = copy.deepcopy(source)
        
        # Determine if we need to modify inner or outer message
        if self._has_inner_email(source):
            self._modify_inner_email(reconstructed, generated_body, 
                                    recipient_mapping, date_transformer)
        else:
            self._modify_message(reconstructed, generated_body,
                               recipient_mapping, date_transformer)
        
        return reconstructed
    
    def _has_inner_email(self, msg: EmailMessage) -> bool:
        """Check if message contains inner email."""
        if msg.is_multipart():
            for part in msg.iter_parts():
                if part.get_content_type() == "message/rfc822":
                    return True
                if part.is_multipart() and self._has_inner_email(part):
                    return True
        return False
    
    def _modify_inner_email(self, msg: EmailMessage, generated_body: Dict[str, str],
                           recipient_mapping: Dict[str, str],
                           date_transformer) -> None:
        """Modify inner email while preserving outer envelope."""
        if msg.is_multipart():
            for part in msg.iter_parts():
                if part.get_content_type() == "message/rfc822":
                    inner_msg = self._get_inner_message(part)
                    if inner_msg:
                        self._modify_message(inner_msg, generated_body,
                                           recipient_mapping, date_transformer)
                elif part.is_multipart():
                    self._modify_inner_email(part, generated_body,
                                           recipient_mapping, date_transformer)
    
    def _modify_message(self, msg: EmailMessage, generated_body: Dict[str, str],
                       recipient_mapping: Dict[str, str],
                       date_transformer) -> None:
        """Modify a single message's body and headers."""
        # Replace body content
        self._replace_body(msg, generated_body)
        
        # Replace recipients
        self._replace_recipients(msg, recipient_mapping)
        
        # Replace dates
        date_transformer.transform_all_dates(msg)
    
    def _replace_body(self, msg: EmailMessage, generated_body: Dict[str, str]) -> None:
        """Replace body content while preserving format."""
        if msg.is_multipart():
            for part in msg.iter_parts():
                content_type = part.get_content_type()
                disposition = part.get_content_disposition()
                filename = part.get_filename()
                
                # Skip attachments and inline images
                if disposition == 'attachment' or (filename and disposition != 'inline'):
                    continue
                if content_type.startswith('image/') and disposition == 'inline':
                    continue
                
                if content_type == 'text/plain':
                    if 'text' in generated_body:
                        part.set_content(generated_body['text'])
                elif content_type == 'text/html':
                    if 'html' in generated_body:
                        part.set_content(generated_body['html'], subtype='html')
                elif part.is_multipart():
                    self._replace_body(part, generated_body)
        else:
            content_type = msg.get_content_type()
            if content_type == 'text/plain':
                if 'text' in generated_body:
                    msg.set_content(generated_body['text'])
            elif content_type == 'text/html':
                if 'html' in generated_body:
                    msg.set_content(generated_body['html'], subtype='html')
    
    def _replace_recipients(self, msg: EmailMessage, mapping: Dict[str, str]) -> None:
        """Replace recipient addresses."""
        from email.utils import parseaddr, formataddr, getaddresses
        
        for header in ['From', 'To', 'Cc', 'Bcc', 'Reply-To', 'Sender']:
            if header in msg:
                addresses = getaddresses([msg[header]])
                new_addresses = []
                
                for display_name, email_addr in addresses:
                    if email_addr in mapping:
                        new_email = mapping[email_addr]
                        if display_name:
                            new_addresses.append(formataddr((display_name, new_email)))
                        else:
                            new_addresses.append(new_email)
                    else:
                        if display_name:
                            new_addresses.append(formataddr((display_name, email_addr)))
                        else:
                            new_addresses.append(email_addr)
                
                msg.replace_header(header, ', '.join(new_addresses))
    
    def _get_inner_message(self, part: MIMEPart) -> Optional[EmailMessage]:
        """Extract inner message from message/rfc822 part."""
        try:
            payload = part.get_payload()
            if isinstance(payload, list) and payload:
                return payload[0]
            elif isinstance(payload, EmailMessage):
                return payload
        except Exception:
            pass
        return None


