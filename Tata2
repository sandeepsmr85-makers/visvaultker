"""
Complete conversation generation with multi-message support.
"""
from typing import Dict, List, Optional, Any, Tuple
from email.message import EmailMessage
from dataclasses import dataclass
import logging
import random
from ..core.config import Difficulty, Settings
from ..concepts.behavior_library import BehaviorLibrary
from ..analysis.style import StyleProfile, StyleAnalyzer

logger = logging.getLogger(__name__)

@dataclass
class GeneratedMessage:
    """A single generated message in a conversation."""
    message_id: str
    sender: str
    recipients: List[str]
    subject: str
    body: Dict[str, str]
    message_type: str  # 'original', 'reply', 'forward'
    depth: int
    references: List[str] = None
    in_reply_to: str = None

class ConversationGenerator:
    """Generates multi-message conversations with context."""
    
    def __init__(self, config: Settings, llm_provider=None):
        self.config = config
        self.llm = llm_provider
        self.style_analyzer = StyleAnalyzer()
    
    def generate_conversation(self, scenario: Dict[str, Any],
                             topology: Dict[str, Any],
                             style_profile: StyleProfile) -> List[GeneratedMessage]:
        """
        Generate a multi-message conversation.
        
        The number of messages depends on:
        - Topology (thread depth, message count)
        - Scenario difficulty
        - Category
        """
        message_count = self._determine_message_count(scenario, topology)
        messages = []
        context = []
        
        for i in range(message_count):
            message = self._generate_message(
                scenario=scenario,
                topology=topology,
                style_profile=style_profile,
                message_index=i,
                total_messages=message_count,
                context=context
            )
            messages.append(message)
            context.append(message.body.get('text', ''))
        
        return messages
    
    def _determine_message_count(self, scenario: Dict[str, Any],
                                 topology: Dict[str, Any]) -> int:
        """Determine number of messages to generate."""
        # Base count from topology
        base_count = min(topology.get('total_messages', 1), 5)
        
        # Adjust based on difficulty
        difficulty = scenario.get('difficulty', Difficulty.MEDIUM)
        difficulty_multiplier = {
            Difficulty.EASY: 1,
            Difficulty.MEDIUM: 2,
            Difficulty.HARD: 3,
            Difficulty.VERY_HARD: 4
        }
        
        multiplier = difficulty_multiplier.get(difficulty, 2)
        
        # Very hard scenarios need multiple messages for context
        if difficulty == Difficulty.VERY_HARD:
            return max(3, base_count * multiplier)
        
        return min(max(1, base_count * multiplier), 6)
    
    def _generate_message(self, scenario: Dict[str, Any],
                         topology: Dict[str, Any],
                         style_profile: StyleProfile,
                         message_index: int,
                         total_messages: int,
                         context: List[str]) -> GeneratedMessage:
        """Generate a single message in the conversation."""
        
        # Determine message type
        message_type = self._determine_message_type(message_index, scenario)
        
        # Determine participants
        participants = topology.get('unique_participants', [])
        sender, recipients = self._select_participants(participants, message_index)
        
        # Generate content based on message position
        content = self._generate_content(
            scenario=scenario,
            message_index=message_index,
            total_messages=total_messages,
            context=context,
            style_profile=style_profile,
            message_type=message_type
        )
        
        # Generate message ID
        import uuid
        message_id = f"<SYN_{uuid.uuid4().hex[:8]}@synthetic.local>"
        
        return GeneratedMessage(
            message_id=message_id,
            sender=sender,
            recipients=recipients,
            subject=self._generate_subject(scenario, message_index),
            body=content,
            message_type=message_type,
            depth=message_index,
            references=[f"<SYN_{uuid.uuid4().hex[:8]}@synthetic.local>" 
                       for _ in range(message_index)] if message_index > 0 else None,
            in_reply_to=f"<SYN_{uuid.uuid4().hex[:8]}@synthetic.local>" 
                       if message_index > 0 else None
        )
    
    def _determine_message_type(self, index: int, 
                                scenario: Dict[str, Any]) -> str:
        """Determine message type based on position."""
        if index == 0:
            return 'original'
        elif scenario.get('platform_switching', False) and index == 1:
            return 'reply'
        elif index > 0 and random.random() < 0.3:
            return 'forward'
        else:
            return 'reply'
    
    def _select_participants(self, participants: List[str], 
                            message_index: int) -> Tuple[str, List[str]]:
        """Select sender and recipients for a message."""
        if not participants:
            return "sender@synthetic.local", ["recipient@synthetic.local"]
        
        # Rotate senders to create realistic conversation
        sender = participants[message_index % len(participants)]
        
        # Select recipients (everyone except sender)
        recipients = [p for p in participants if p != sender]
        
        # For group conversations, include multiple recipients
        if len(recipients) > 1:
            # Include 1-3 recipients
            num_recipients = min(random.randint(1, 3), len(recipients))
            recipients = random.sample(recipients, num_recipients)
        
        return sender, recipients
    
    def _generate_content(self, scenario: Dict[str, Any],
                         message_index: int,
                         total_messages: int,
                         context: List[str],
                         style_profile: StyleProfile,
                         message_type: str) -> Dict[str, str]:
        """Generate message content based on position in conversation."""
        
        # Build prompt based on message position
        prompt = self._build_prompt(
            scenario=scenario,
            message_index=message_index,
            total_messages=total_messages,
            context=context,
            style_profile=style_profile,
            message_type=message_type
        )
        
        # Generate content using LLM
        if self.llm:
            try:
                response = self.llm.generate(prompt)
                body_text = self._parse_response(response)
            except Exception as e:
                logger.warning(f"LLM generation failed, using template: {e}")
                body_text = self._generate_template_content(
                    scenario, message_index, total_messages
                )
        else:
            body_text = self._generate_template_content(
                scenario, message_index, total_messages
            )
        
        # Create text and HTML versions
        return {
            'text': body_text,
            'html': f"<html><body><p>{body_text}</p></body></html>"
        }
    
    def _build_prompt(self, scenario: Dict[str, Any],
                     message_index: int,
                     total_messages: int,
                     context: List[str],
                     style_profile: StyleProfile,
                     message_type: str) -> str:
        """Build LLM prompt for message generation."""
        
        category = scenario.get('category', 'NORMAL')
        concept = scenario.get('concept', '')
        difficulty = scenario.get('difficulty', 'MEDIUM')
        action = scenario.get('action', '')
        
        # Adjust content based on message position
        if message_index == 0:
            # First message: innocent/normal start
            content_instruction = "Write an innocent, normal email that starts a conversation."
        elif message_index == total_messages - 1:
            # Last message: reveal the full intent
            content_instruction = f"Write an email that reveals the full intent: {concept}"
        else:
            # Middle messages: gradual escalation
            escalation = message_index / total_messages
            content_instruction = (
                f"Write an email that shows {escalation:.0%} of the intent. "
                f"Subtle hints about: {concept}"
            )
        
        prompt = f"""
Generate email message {message_index + 1} of {total_messages} in a conversation.

Category: {category}
Concept: {concept}
Difficulty: {difficulty}
Action: {action}
Message type: {message_type}

{content_instruction}

Style requirements:
- Formality: {style_profile.formality:.2f} (0=informal, 1=formal)
- Verbosity: {style_profile.verbosity:.2f}
- Technical level: {style_profile.technical_level:.2f}

Previous messages (for context):
{chr(10).join(context[-3:]) if context else 'None'}

Write only the email body (no headers).
Length: 40-120 words.
"""
        return prompt
    
    def _parse_response(self, response: str) -> str:
        """Parse LLM response."""
        import json
        import re
        
        # Try to parse JSON
        cleaned = response.strip()
        cleaned = re.sub(r'^```(json)?', '', cleaned).strip()
        cleaned = re.sub(r'```$', '', cleaned).strip()
        
        try:
            data = json.loads(cleaned)
            return data.get('body_text', cleaned)
        except json.JSONDecodeError:
            return cleaned
    
    def _generate_template_content(self, scenario: Dict[str, Any],
                                  message_index: int,
                                  total_messages: int) -> str:
        """Generate content using templates (fallback)."""
        category = scenario.get('category', 'NORMAL')
        
        templates = {
            'BUSINESS_SENSITIVE': [
                "Just checking on the status of that project we discussed.",
                "I think we need to be careful about how we handle this.",
                "The numbers seem to be different from what was expected.",
                "We should probably keep this between us for now."
            ],
            'PLATFORM_SWITCHING': [
                "Can we discuss this over coffee later?",
                "This is too sensitive for email, call me.",
                "Let's move this to a different channel.",
                "I don't want this in writing."
            ],
            'PERSONAL_SUSPICIOUS': [
                "Hey, are we still on for the surprise party?",
                "I need help with my personal finances.",
                "Can you check on my house while I'm away?",
                "The wedding planning is getting complicated."
            ],
            'NORMAL': [
                "Here's the weekly status update.",
                "Meeting agenda for Thursday.",
                "Please review the attached document.",
                "Following up on the project timeline."
            ]
        }
        
        category_templates = templates.get(category, templates['NORMAL'])
        return category_templates[message_index % len(category_templates)]
    
    def _generate_subject(self, scenario: Dict[str, Any], 
                         message_index: int) -> str:
        """Generate subject for message."""
        if message_index == 0:
            return "Quick question"
        elif message_index > 0:
            return f"Re: Quick question ({message_index})"
        return "FW: Important"


