        }
        
        prompt = f"""
Generate a synthetic email body following EXACT structural requirements.

STRUCTURE:
- Paragraphs: {structure.get('paragraph_count', 3)}
- Sentences: {structure.get('sentence_count', 6)}
- Words: {structure.get('word_count', 50)}
- Greeting: {structure.get('greeting_style', 'Hi')}
- Closing: {structure.get('closing_style', 'Best regards')}
- Formality: {structure.get('formality_level', 'semi_formal')}
- Tone: {structure.get('tone', 'professional')}
- Bullet points: {structure.get('has_bullet_points', False)}
- Numbered list: {structure.get('has_numbered_list', False)}

CATEGORY: {category}
DIFFICULTY: {difficulty}
CONCEPT: {concept}

CONTENT INSTRUCTIONS:
{category_instructions.get(category, '')}

Return JSON with 'text' field containing the email body.
"""
        
        try:
            response = self.llm.generate(prompt, max_tokens=500, temperature=0.8)
            json_match = re.search(r'\{.*\}', response, re.DOTALL)
            if json_match:
                data = json.loads(json_match.group(0))
                text = data.get('text', response)
                return {'text': text, 'html': f"<html><body><p>{text}</p></body></html>"}
        except Exception as e:
            logger.error(f"LLM generation failed: {e}")
        
        return self._fallback_generation(category, concept)
    
    def _fallback_generation(self, category: str, concept: str) -> Dict[str, str]:
        templates = {
            'BUSINESS_SENSITIVE': f"I need to discuss the {concept} situation. This is highly confidential and should not be shared outside our team. Please review the attached documents and keep this information private. Let me know your thoughts after reviewing.",
            'PLATFORM_SWITCHING': f"We cannot discuss {concept} over email. Call me on my personal number after work hours. This is too sensitive for company channels. Meet me in person tomorrow to discuss further.",
            'PERSONAL_SUSPICIOUS': f"I'm having some personal issues related to {concept}. I need help figuring out my finances. This is causing stress and affecting my work. Can we talk privately about this situation?",
            'NORMAL': f"Here's the update on {concept}. We're making good progress and should have everything completed by next week. Please review the attached documents and provide feedback by Friday."
        }
        
        text = templates.get(category, templates['NORMAL'])
        return {'text': text, 'html': f"<html><body><p>{text}</p></body></html>"}


