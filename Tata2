"""LLM-powered analysis."""
from typing import Dict, Any
import json
import re
import logging
from ..llm.provider import LLMProvider

logger = logging.getLogger(__name__)

class LLMAnalyzer:
    def __init__(self, llm_provider: LLMProvider):
        self.llm = llm_provider
    
    def analyze_structure(self, email_text: str) -> Dict[str, Any]:
        prompt = """
Analyze the email and extract structural elements. Return ONLY JSON:
{
    "paragraph_count": int,
    "sentence_count": int,
    "word_count": int,
    "has_greeting": bool,
    "has_signature": bool,
    "has_bullet_points": bool,
    "has_numbered_list": bool,
    "formality_level": "formal|semi_formal|informal",
    "tone": "professional|friendly|urgent|casual",
    "greeting_style": "Dear|Hi|Hello|Hey|None",
    "closing_style": "Best regards|Sincerely|Thanks|Cheers|None"
}
"""
        try:
            response = self.llm.analyze(prompt, email_text)
            json_match = re.search(r'\{.*\}', response, re.DOTALL)
            if json_match:
                return json.loads(json_match.group(0))
        except Exception as e:
            logger.error(f"LLM analysis failed: {e}")
        
        return self._fallback_analysis(email_text)
    
    def _fallback_analysis(self, text: str) -> Dict[str, Any]:
        words = text.split()
        sentences = [s for s in text.replace('\n', ' ').split('.') if s.strip()]
        paragraphs = [p for p in text.split('\n\n') if p.strip()]
        
        return {
            "paragraph_count": len(paragraphs),
            "sentence_count": len(sentences),
            "word_count": len(words),
            "has_greeting": any(g in text for g in ['Dear', 'Hi', 'Hello', 'Hey']),
            "has_signature": any(s in text for s in ['Best', 'Sincerely', 'Thanks', 'Cheers']),
            "has_bullet_points": '-' in text or '•' in text,
            "has_numbered_list": bool(re.search(r'\d+\.', text)),
            "formality_level": "semi_formal",
            "tone": "professional",
            "greeting_style": "Hi",
            "closing_style": "Best regards"
        }


