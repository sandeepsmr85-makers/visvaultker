"""
Complete source similarity validation.
"""
from typing import Dict, List, Any, Set
from email.message import EmailMessage
import re
from difflib import SequenceMatcher
import hashlib
import logging
from ..core.exceptions import ValidationError

logger = logging.getLogger(__name__)

class SourceSimilarityValidator:
    """Validates that generated content isn't too similar to source."""
    
    def __init__(self, similarity_threshold: float = 0.7):
        self.similarity_threshold = similarity_threshold
    
    def validate(self, source: EmailMessage, generated: EmailMessage) -> Dict[str, Any]:
        """Validate source similarity."""
        results = {
            'passed': True,
            'checks': {},
            'errors': []
        }
        
        # Extract text from both messages
        source_text = self._extract_text(source)
        generated_text = self._extract_text(generated)
        
        # Check for exact phrase reuse
        self._check_phrase_reuse(source_text, generated_text, results)
        
        # Check overall similarity
        self._check_similarity(source_text, generated_text, results)
        
        # Check for template duplication
        self._check_duplication(source_text, generated_text, results)
        
        results['passed'] = len(results['errors']) == 0
        return results
    
    def _extract_text(self, msg: EmailMessage) -> str:
        """Extract all text from message."""
        texts = []
        
        def _walk(part):
            if part.is_multipart():
                for sub_part in part.iter_parts():
                    _walk(sub_part)
            else:
                if part.get_content_type() == 'text/plain':
                    try:
                        texts.append(part.get_content())
                    except Exception:
                        pass
                elif part.get_content_type() == 'text/html':
                    try:
                        from bs4 import BeautifulSoup
                        soup = BeautifulSoup(part.get_content(), 'lxml')
                        texts.append(soup.get_text())
                    except Exception:
                        pass
        
        _walk(msg)
        return '\n'.join(texts)
    
    def _check_phrase_reuse(self, source: str, generated: str,
                           results: Dict[str, Any]) -> None:
        """Check for reuse of source phrases."""
        # Extract phrases from source (3-5 word sequences)
        source_words = source.split()
        source_phrases = set()
        
        for i in range(len(source_words) - 3):
            phrase = ' '.join(source_words[i:i+4])
            if len(phrase.split()) == 4:  # 4-word phrases
                source_phrases.add(phrase.lower())
        
        # Check if any source phrases appear in generated
        reused_phrases = []
        generated_lower = generated.lower()
        
        for phrase in source_phrases:
            if phrase in generated_lower:
                reused_phrases.append(phrase)
        
        results['checks']['phrase_reuse'] = {
            'reused_count': len(reused_phrases),
            'reused_phrases': reused_phrases[:5],
            'passed': len(reused_phrases) == 0
        }
        
        if reused_phrases:
            results['errors'].append(
                f"Reused {len(reused_phrases)} phrases from source"
            )
    
    def _check_similarity(self, source: str, generated: str,
                         results: Dict[str, Any]) -> None:
        """Check overall text similarity."""
        if not source or not generated:
            results['checks']['similarity'] = {
                'ratio': 0.0,
                'passed': True
            }
            return
        
        similarity = SequenceMatcher(None, source, generated).ratio()
        
        results['checks']['similarity'] = {
            'ratio': similarity,
            'threshold': self.similarity_threshold,
            'passed': similarity < self.similarity_threshold
        }
        
        if similarity >= self.similarity_threshold:
            results['errors'].append(
                f"Generated content too similar to source: {similarity:.2f}"
            )
    
    def _check_duplication(self, source: str, generated: str,
                          results: Dict[str, Any]) -> None:
        """Check for template content duplication."""
        # Check if generated content is just a modified version of source
        source_hash = hashlib.md5(source.encode()).hexdigest()
        generated_hash = hashlib.md5(generated.encode()).hexdigest()
        
        results['checks']['duplication'] = {
            'source_hash': source_hash,
            'generated_hash': generated_hash,
            'passed': source_hash != generated_hash
        }
        
        if source_hash == generated_hash:
            results['errors'].append("Generated content is identical to source")


