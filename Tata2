"""LLM factory."""
from typing import Optional
from ..core.config import LLMConfig
from .provider import LLMProvider, OpenAIProvider, AnthropicProvider, LocalProvider
import logging

logger = logging.getLogger(__name__)

def create_llm_provider(config: LLMConfig) -> Optional[LLMProvider]:
    if config.provider == "openai":
        if not config.api_key:
            logger.warning("OpenAI requires API key")
            return None
        return OpenAIProvider(api_key=config.api_key, model=config.model)
    
    elif config.provider == "anthropic":
        if not config.api_key:
            logger.warning("Anthropic requires API key")
            return None
        return AnthropicProvider(api_key=config.api_key, model=config.model)
    
    elif config.provider == "local":
        base_url = config.base_url or "http://localhost:11434"
        return LocalProvider(base_url=base_url, model=config.model)
    
    logger.warning(f"Unknown provider: {config.provider}")
    return None


