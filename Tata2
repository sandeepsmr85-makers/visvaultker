"""Typo generation."""
from typing import Optional
import random
import logging
from ..core.config import TypoIntensity

logger = logging.getLogger(__name__)

class TypoEngine:
    def __init__(self, seed: Optional[int] = None):
        if seed:
            random.seed(seed)
    
    def apply_typos(self, text: str, intensity: TypoIntensity) -> str:
        intensity_map = {
            TypoIntensity.LIGHT: 0.02,
            TypoIntensity.MEDIUM: 0.05,
            TypoIntensity.HEAVY: 0.10
        }
        
        rate = intensity_map.get(intensity, 0.05)
        words = text.split()
        num_typos = max(1, int(len(words) * rate))
        indices = random.sample(range(len(words)), min(num_typos, len(words)))
        
        for idx in indices:
            if len(words[idx]) > 3:
                words[idx] = self._random_typo(words[idx])
        
        return ' '.join(words)
    
    def _random_typo(self, word: str) -> str:
        typo_type = random.choice(['substitute', 'omit', 'transpose', 'duplicate'])
        
        if typo_type == 'substitute':
            pos = random.randint(0, len(word) - 1)
            replacement = random.choice('abcdefghijklmnopqrstuvwxyz')
            return word[:pos] + replacement + word[pos+1:]
        elif typo_type == 'omit' and len(word) > 1:
            pos = random.randint(0, len(word) - 1)
            return word[:pos] + word[pos+1:]
        elif typo_type == 'transpose' and len(word) > 2:
            pos = random.randint(0, len(word) - 2)
            return word[:pos] + word[pos+1] + word[pos] + word[pos+2:]
        elif typo_type == 'duplicate':
            pos = random.randint(0, len(word) - 1)
            return word[:pos] + word[pos] + word[pos:]
        
        return word


