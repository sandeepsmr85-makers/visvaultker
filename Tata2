"""
Complete body analysis with format preservation.
"""
from typing import Dict, List, Optional, Any, Tuple
from email.message import EmailMessage
from bs4 import BeautifulSoup
import re
import logging

logger = logging.getLogger(__name__)

class BodyAnalyzer:
    """Analyzes email body structure and format."""
    
    def analyze(self, msg: EmailMessage) -> Dict[str, Any]:
        """Analyze complete body structure."""
        analysis = {
            'mime_type': msg.get_content_type(),
            'is_multipart': msg.is_multipart(),
            'body_parts': [],
            'total_visible_chars': 0,
            'total_words': 0,
            'total_sentences': 0,
            'total_paragraphs': 0,
            'has_html': False,
            'has_plain_text': False,
            'has_attachments': False,
            'has_inline_images': False,
            'has_tables': False,
            'has_lists': False,
            'has_links': False,
            'has_images': False,
            'has_signature': False,
            'has_quoted_reply': False
        }
        
        # Analyze body parts
        body_parts = self._get_body_parts(msg)
        for part in body_parts:
            part_analysis = self._analyze_part(part)
            analysis['body_parts'].append(part_analysis)
            
            # Aggregate statistics
            analysis['total_visible_chars'] += part_analysis['visible_chars']
            analysis['total_words'] += part_analysis['word_count']
            analysis['total_sentences'] += part_analysis['sentence_count']
            analysis['total_paragraphs'] += part_analysis['paragraph_count']
            
            if part_analysis['is_html']:
                analysis['has_html'] = True
                analysis['has_tables'] = analysis['has_tables'] or part_analysis['has_tables']
                analysis['has_lists'] = analysis['has_lists'] or part_analysis['has_lists']
                analysis['has_links'] = analysis['has_links'] or part_analysis['has_links']
                analysis['has_images'] = analysis['has_images'] or part_analysis['has_images']
            else:
                analysis['has_plain_text'] = True
            
            analysis['has_signature'] = analysis['has_signature'] or part_analysis['has_signature']
            analysis['has_quoted_reply'] = analysis['has_quoted_reply'] or part_analysis['has_quoted_reply']
        
        # Check for attachments and inline images
        analysis['has_attachments'] = len(self._get_attachments(msg)) > 0
        analysis['has_inline_images'] = len(self._get_inline_images(msg)) > 0
        
        return analysis
    
    def _get_body_parts(self, msg: EmailMessage) -> List[EmailMessage]:
        """Get body parts (text/plain and text/html)."""
        body_parts = []
        
        def _walk(part):
            if part.is_multipart():
                for sub_part in part.iter_parts():
                    _walk(sub_part)
            else:
                content_type = part.get_content_type()
                disposition = part.get_content_disposition()
                filename = part.get_filename()
                
                if disposition == 'attachment' or (filename and disposition != 'inline'):
                    return
                if content_type.startswith('image/') and disposition == 'inline':
                    return
                if content_type in ['text/plain', 'text/html']:
                    body_parts.append(part)
        
        _walk(msg)
        return body_parts
    
    def _get_attachments(self, msg: EmailMessage) -> List[EmailMessage]:
        """Get attachment parts."""
        attachments = []
        
        def _walk(part):
            if part.is_multipart():
                for sub_part in part.iter_parts():
                    _walk(sub_part)
            else:
                disposition = part.get_content_disposition()
                filename = part.get_filename()
                if disposition == 'attachment' or (filename and disposition != 'inline'):
                    attachments.append(part)
        
        _walk(msg)
        return attachments
    
    def _get_inline_images(self, msg: EmailMessage) -> List[EmailMessage]:
        """Get inline image parts."""
        images = []
        
        def _walk(part):
            if part.is_multipart():
                for sub_part in part.iter_parts():
                    _walk(sub_part)
            else:
                content_type = part.get_content_type()
                disposition = part.get_content_disposition()
                if content_type.startswith('image/') and disposition == 'inline':
                    images.append(part)
        
        _walk(msg)
        return images
    
    def _analyze_part(self, part: EmailMessage) -> Dict[str, Any]:
        """Analyze a single body part."""
        content_type = part.get_content_type()
        is_html = content_type == 'text/html'
        
        analysis = {
            'content_type': content_type,
            'is_html': is_html,
            'visible_chars': 0,
            'word_count': 0,
            'sentence_count': 0,
            'paragraph_count': 0,
            'has_tables': False,
            'has_lists': False,
            'has_links': False,
            'has_images': False,
            'has_signature': False,
            'has_quoted_reply': False,
            'heading_count': 0,
            'table_count': 0,
            'list_count': 0,
            'link_count': 0,
            'image_count': 0
        }
        
        try:
            content = part.get_content()
            
            if is_html:
                soup = BeautifulSoup(content, 'lxml')
                
                # Extract visible text
                visible_text = soup.get_text()
                analysis['visible_chars'] = len(visible_text)
                analysis['word_count'] = len(visible_text.split())
                
                # Count elements
                analysis['paragraph_count'] = len(soup.find_all('p'))
                analysis['heading_count'] = len(soup.find_all(['h1', 'h2', 'h3', 'h4', 'h5', 'h6']))
                analysis['table_count'] = len(soup.find_all('table'))
                analysis['list_count'] = len(soup.find_all(['ul', 'ol']))
                analysis['link_count'] = len(soup.find_all('a'))
                analysis['image_count'] = len(soup.find_all('img'))
                
                analysis['has_tables'] = analysis['table_count'] > 0
                analysis['has_lists'] = analysis['list_count'] > 0
                analysis['has_links'] = analysis['link_count'] > 0
                analysis['has_images'] = analysis['image_count'] > 0
                
                # Count sentences
                sentences = re.split(r'[.!?]+', visible_text)
                analysis['sentence_count'] = len([s for s in sentences if s.strip()])
                
                # Check for signature
                signature_patterns = [
                    r'Best regards',
                    r'Sincerely',
                    r'Thanks',
                    r'Cheers',
                    r'Regards'
                ]
                analysis['has_signature'] = any(
                    re.search(pattern, visible_text, re.IGNORECASE) 
                    for pattern in signature_patterns
                )
                
                # Check for quoted reply
                analysis['has_quoted_reply'] = '>' in visible_text or \
                    bool(soup.find_all('blockquote'))
            else:
                # Plain text
                visible_text = content
                analysis['visible_chars'] = len(visible_text)
                analysis['word_count'] = len(visible_text.split())
                
                # Count paragraphs
                paragraphs = [p for p in visible_text.split('\n\n') if p.strip()]
                analysis['paragraph_count'] = len(paragraphs)
                
                # Count sentences
                sentences = re.split(r'[.!?]+', visible_text)
                analysis['sentence_count'] = len([s for s in sentences if s.strip()])
                
                # Check for signature
                signature_patterns = [
                    r'Best regards',
                    r'Sincerely',
                    r'Thanks',
                    r'Cheers',
                    r'Regards'
                ]
                analysis['has_signature'] = any(
                    re.search(pattern, visible_text, re.IGNORECASE) 
                    for pattern in signature_patterns
                )
                
                # Check for quoted reply
                analysis['has_quoted_reply'] = bool(re.search(r'^>', visible_text, re.MULTILINE))
        
        except Exception as e:
            logger.warning(f"Failed to analyze part: {e}")
        
        return analysis
    
    def preserve_html_structure(self, original_html: str, new_content: str) -> str:
        """Preserve HTML structure while replacing content."""
        try:
            soup = BeautifulSoup(original_html, 'lxml')
            
            # Find all paragraph elements
            paragraphs = soup.find_all('p')
            
            if not paragraphs:
                # No paragraphs, create one
                new_p = soup.new_tag('p')
                new_p.string = new_content
                if soup.body:
                    soup.body.append(new_p)
                else:
                    soup.append(new_p)
                return str(soup)
            
            # Split new content into sentences
            sentences = re.split(r'(?<=[.!?])\s+', new_content.strip())
            
            # Distribute sentences across paragraphs
            sentences_per_para = max(1, len(sentences) // len(paragraphs))
            
            for i, para in enumerate(paragraphs):
                start_idx = i * sentences_per_para
                end_idx = min(start_idx + sentences_per_para, len(sentences))
                
                if start_idx < len(sentences):
                    new_text = ' '.join(sentences[start_idx:end_idx])
                    
                    # Clear existing content but preserve formatting
                    para.clear()
                    para.string = new_text
                else:
                    # Remove extra paragraphs
                    para.decompose()
            
            return str(soup)
        except Exception as e:
            logger.error(f"Failed to preserve HTML structure: {e}")
            return f"<html><body><p>{new_content}</p></body></html>"


