"""Inner email detection."""
from email.message import EmailMessage, MIMEPart
from email import policy
from email.parser import BytesParser
from typing import Optional, Tuple, Dict
import re
import logging

logger = logging.getLogger(__name__)

class InnerEmailDetector:
    def detect(self, msg: EmailMessage) -> Tuple[EmailMessage, bool, Dict]:
        metadata = {'has_inner': False, 'detection_method': None, 'detection_confidence': 0.0}
        
        # Check for message/rfc822 parts
        if msg.is_multipart():
            for part in msg.iter_parts():
                if part.get_content_type() == "message/rfc822":
                    inner = self._extract_inner(part)
                    if inner:
                        metadata.update({'has_inner': True, 'detection_method': 'message_rfc822', 'detection_confidence': 1.0})
                        return inner, True, metadata
        
        # Check for forwarded content
        subject = msg.get('Subject', '').lower()
        if subject.startswith(('fw:', 'fwd:', 'forward:')):
            body_text = self._extract_text(msg)
            if self._contains_email_headers(body_text):
                reconstructed = self._reconstruct(body_text)
                if reconstructed:
                    metadata.update({'has_inner': True, 'detection_method': 'forwarded', 'detection_confidence': 0.8})
                    return reconstructed, True, metadata
        
        return msg, False, metadata
    
    def _extract_inner(self, part: MIMEPart) -> Optional[EmailMessage]:
        try:
            payload = part.get_payload()
            if isinstance(payload, list) and payload:
                return payload[0]
            elif isinstance(payload, EmailMessage):
                return payload
        except Exception:
            pass
        return None
    
    def _extract_text(self, msg: EmailMessage) -> str:
        texts = []
        def _walk(part):
            if part.is_multipart():
                for sub in part.iter_parts():
                    _walk(sub)
            else:
                if part.get_content_type() == 'text/plain':
                    try:
                        texts.append(part.get_content())
                    except Exception:
                        pass
        _walk(msg)
        return '\n'.join(texts)
    
    def _contains_email_headers(self, text: str) -> bool:
        headers = ['From:', 'To:', 'Subject:', 'Date:']
        found = sum(1 for h in headers if re.search(f'^{h}', text, re.MULTILINE | re.IGNORECASE))
        return found >= 3
    
    def _reconstruct(self, text: str) -> Optional[EmailMessage]:
        try:
            parser = BytesParser(policy=policy.default)
            return parser.parsebytes(text.strip().encode('utf-8'))
        except Exception:
            return None


# app/rfc822/dates.py
"""Date transformation."""
from email.message import EmailMessage
from email.utils import parsedate_to_datetime, format_datetime
from datetime import timedelta
import logging

logger = logging.getLogger(__name__)

class DateTransformer:
    def __init__(self, offset_days: int = -2):
        self.offset = timedelta(days=offset_days)
    
    def transform_all_dates(self, msg: EmailMessage) -> None:
        if 'Date' in msg:
            try:
                original = parsedate_to_datetime(msg['Date'])
                new_date = original + self.offset
                msg.replace_header('Date', format_datetime(new_date))
            except Exception as e:
                logger.warning(f"Date transformation failed: {e}")
        
        if msg.is_multipart():
            for part in msg.iter_parts():
                if part.get_content_type() == 'message/rfc822':
                    payload = part.get_payload()
                    inner = None
                    if isinstance(payload, list) and payload:
                        inner = payload[0]
                    elif isinstance(payload, EmailMessage):
                        inner = payload
                    if inner:
                        self.transform_all_dates(inner)


# app/rfc822/recipients.py
"""Recipient mapping."""
from email.message import EmailMessage
from email.utils import getaddresses
from typing import Dict, List, Set
import random
import logging

logger = logging.getLogger(__name__)

class RecipientTopologyMapper:
    def __init__(self, recipient_pool: List[str]):
        self.recipient_pool = recipient_pool
        self.mapping: Dict[str, str] = {}
    
    def create_mapping(self, msg: EmailMessage) -> Dict[str, str]:
        original = self._extract_recipients(msg)
        available = list(set(self.recipient_pool) - set(original))
        random.shuffle(available)
        
        for email in original:
            if email not in self.mapping:
                if available:
                    self.mapping[email] = available.pop()
                else:
                    self.mapping[email] = random.choice(self.recipient_pool)
        
        return self.mapping
    
    def _extract_recipients(self, msg: EmailMessage) -> Set[str]:
        recipients = set()
        for header in ['From', 'To', 'Cc', 'Bcc', 'Reply-To']:
            if header in msg:
                for _, email in getaddresses([msg[header]]):
                    if email:
                        recipients.add(email)
        return recipients


# app/rfc822/reconstruct.py
"""RFC 822 reconstruction."""
from email.message import EmailMessage, MIMEPart
from typing import Dict, Optional
import copy
import logging

logger = logging.getLogger(__name__)

class RFC822Reconstructor:
    def reconstruct(self, source: EmailMessage, target: EmailMessage,
                    generated_body: Dict[str, str],
                    recipient_mapping: Dict[str, str],
                    date_transformer) -> EmailMessage:
        reconstructed = copy.deepcopy(source)
        
        if self._has_inner_email(source):
            self._modify_inner(reconstructed, generated_body, recipient_mapping, date_transformer)
        else:
            self._modify_message(reconstructed, generated_body, recipient_mapping, date_transformer)
        
        return reconstructed
    
    def _has_inner_email(self, msg: EmailMessage) -> bool:
        if msg.is_multipart():
            for part in msg.iter_parts():
                if part.get_content_type() == "message/rfc822":
                    return True
        return False
    
    def _modify_inner(self, msg: EmailMessage, body: Dict[str, str],
                     mapping: Dict[str, str], date_transformer) -> None:
        if msg.is_multipart():
            for part in msg.iter_parts():
                if part.get_content_type() == "message/rfc822":
                    inner = self._get_inner(part)
                    if inner:
                        self._modify_message(inner, body, mapping, date_transformer)
    
    def _modify_message(self, msg: EmailMessage, body: Dict[str, str],
                       mapping: Dict[str, str], date_transformer) -> None:
        self._replace_body(msg, body)
        self._replace_recipients(msg, mapping)
        date_transformer.transform_all_dates(msg)
    
    def _replace_body(self, msg: EmailMessage, body: Dict[str, str]) -> None:
        if msg.is_multipart():
            for part in msg.iter_parts():
                content_type = part.get_content_type()
                if content_type == 'text/plain' and 'text' in body:
                    part.set_content(body['text'])
                elif content_type == 'text/html' and 'html' in body:
                    part.set_content(body['html'], subtype='html')
        else:
            content_type = msg.get_content_type()
            if content_type == 'text/plain' and 'text' in body:
                msg.set_content(body['text'])
            elif content_type == 'text/html' and 'html' in body:
                msg.set_content(body['html'], subtype='html')
    
    def _replace_recipients(self, msg: EmailMessage, mapping: Dict[str, str]) -> None:
        from email.utils import getaddresses, formataddr
        for header in ['From', 'To', 'Cc', 'Bcc', 'Reply-To']:
            if header in msg:
                addresses = getaddresses([msg[header]])
                new_addresses = []
                for name, email in addresses:
                    if email in mapping:
                        new_email = mapping[email]
                        new_addresses.append(formataddr((name, new_email)) if name else new_email)
                    else:
                        new_addresses.append(formataddr((name, email)) if name else email)
                msg.replace_header(header, ', '.join(new_addresses))
    
    def _get_inner(self, part: MIMEPart) -> Optional[EmailMessage]:
        try:
            payload = part.get_payload()
            if isinstance(payload, list) and payload:
                return payload[0]
            elif isinstance(payload, EmailMessage):
                return payload
        except Exception:
            pass
        return None


