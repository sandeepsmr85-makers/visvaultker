"""
Complete main entry point with CLI support.
"""
import argparse
import sys
from pathlib import Path
import logging
from typing import Optional

from .core.config import Settings, Difficulty, TypoIntensity
from .core.logging import setup_logging
from .core.exceptions import PlatformError
from .generation.batch_generator import BatchGenerator

logger = logging.getLogger(__name__)

def main():
    """Main CLI entry point."""
    parser = argparse.ArgumentParser(
        description="Synthetic RFC 822 Communication Generation Platform",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python -m app generate --templates ./templates --recipients ./input/recipients.txt --output ./generated_dataset
  python -m app generate --config config.yaml
  python -m app analyze --templates ./templates
  python -m app validate --dataset ./generated_dataset
        """
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Command to execute')
    
    # Generate command
    generate_parser = subparsers.add_parser('generate', help='Generate synthetic dataset')
    generate_parser.add_argument('--config', type=Path, default=Path('./config/default.yaml'),
                                help='Configuration file path')
    generate_parser.add_argument('--templates', type=Path, help='Template directory')
    generate_parser.add_argument('--recipients', type=Path, help='Recipient file')
    generate_parser.add_argument('--output', type=Path, help='Output directory')
    generate_parser.add_argument('--business-sensitive', type=int, help='Number of business sensitive samples')
    generate_parser.add_argument('--platform-switching', type=int, help='Number of platform switching samples')
    generate_parser.add_argument('--personal-suspicious', type=int, help='Number of personal suspicious samples')
    generate_parser.add_argument('--normal', type=int, help='Number of normal samples')
    generate_parser.add_argument('--difficulty', choices=['easy', 'medium', 'hard', 'very_hard', 'mixed'],
                                help='Difficulty level')
    generate_parser.add_argument('--typo', action='store_true', help='Enable typo generation')
    generate_parser.add_argument('--typo-intensity', choices=['light', 'medium', 'heavy'],
                                help='Typo intensity level')
    generate_parser.add_argument('--seed', type=int, help='Random seed for reproducibility')
    generate_parser.add_argument('--verbose', action='store_true', help='Enable verbose logging')
    
    # Analyze command
    analyze_parser = subparsers.add_parser('analyze', help='Analyze template corpus')
    analyze_parser.add_argument('--templates', type=Path, required=True, help='Template directory')
    analyze_parser.add_argument('--output', type=Path, help='Analysis output file')
    
    # Validate command
    validate_parser = subparsers.add_parser('validate', help='Validate generated dataset')
    validate_parser.add_argument('--dataset', type=Path, required=True, help='Dataset directory')
    validate_parser.add_argument('--ground-truth', type=Path, help='Ground truth directory')
    
    args = parser.parse_args()
    
    # Setup logging
    log_level = logging.DEBUG if getattr(args, 'verbose', False) else logging.INFO
    setup_logging(level=log_level)
    
    try:
        if args.command == 'generate':
            _handle_generate(args)
        elif args.command == 'analyze':
            _handle_analyze(args)
        elif args.command == 'validate':
            _handle_validate(args)
        else:
            parser.print_help()
            sys.exit(1)
            
    except PlatformError as e:
        logger.error(f"Platform error: {e}")
        sys.exit(1)
    except Exception as e:
        logger.error(f"Unexpected error: {e}")
        sys.exit(1)

def _handle_generate(args):
    """Handle generate command."""
    # Load configuration
    config = Settings()
    if args.config.exists():
        config.load_yaml(args.config)
    
    # Override with command-line arguments
    if args.templates:
        config.template_directory = args.templates
    if args.recipients:
        config.recipient_file = args.recipients
    if args.output:
        config.output_directory = args.output
    if args.business_sensitive is not None:
        config.generation.business_sensitive = args.business_sensitive
    if args.platform_switching is not None:
        config.generation.platform_switching = args.platform_switching
    if args.personal_suspicious is not None:
        config.generation.personal_suspicious = args.personal_suspicious
    if args.normal is not None:
        config.generation.normal = args.normal
    if args.difficulty:
        config.generation.difficulty = Difficulty(args.difficulty.upper())
    if args.typo:
        config.generation.typo_enabled = True
    if args.typo_intensity:
        config.generation.typo_intensity = TypoIntensity(args.typo_intensity.upper())
    if args.seed is not None:
        config.random_seed = args.seed
    
    # Ensure directories exist
    config.ensure_directories()
    
    logger.info("Starting synthetic RFC 822 generation...")
    logger.info(f"Configuration: {args.config}")
    logger.info(f"Templates: {config.template_directory}")
    logger.info(f"Recipients: {config.recipient_file}")
    logger.info(f"Output: {config.output_directory}")
    
    # Initialize batch generator
    generator = BatchGenerator(config)
    
    # Generate dataset
    results = generator.generate_dataset()
    
    # Print summary
    print("\n" + "=" * 70)
    print(" SYNTHETIC RFC 822 GENERATION COMPLETE")
    print("=" * 70)
    print(f" Total requested:    {results['progress']['total_requested']}")
    print(f" Successfully generated: {results['progress']['completed']}")
    print(f" Failed:             {results['progress']['failed']}")
    print(f" Completion rate:    {results['progress']['completion_percentage']:.1f}%")
    print("\n By category:")
    for category, count in results['progress']['by_category'].items():
        requested = getattr(config.generation, category.lower().replace('_', '_'), 0)
        print(f"   {category:<25} {count}/{requested}")
    print(f"\n Manifest: {results['manifest_path']}")
    print(f" Ground truth: {config.ground_truth_directory}")
    print("=" * 70)

def _handle_analyze(args):
    """Handle analyze command."""
    from .scripts.analyze_corpus import analyze_corpus
    analyze_corpus(args.templates, args.output)

def _handle_validate(args):
    """Handle validate command."""
    from .validation.dataset_validator import validate_dataset
    validate_dataset(args.dataset, args.ground_truth)


if __name__ == "__main__":
    main()
