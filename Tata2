"""
Complete RFC 822 parser with advanced structure analysis.
"""
from email import policy
from email.message import EmailMessage, MIMEPart
from email.parser import BytesParser, Parser
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple, Set
import hashlib
import logging
from ..core.exceptions import ParsingError

logger = logging.getLogger(__name__)

class RFC822Parser:
    """Advanced RFC 822 parser with complete structure profiling."""
    
    def __init__(self, msg_policy=policy.default):
        self.policy = msg_policy
        self._bytes_parser = BytesParser(policy=msg_policy)
        self._string_parser = Parser(policy=msg_policy)
    
    def parse_bytes(self, data: bytes) -> EmailMessage:
        """Parse RFC 822 message from bytes."""
        try:
            return self._bytes_parser.parsebytes(data)
        except Exception as e:
            raise ParsingError(f"Failed to parse RFC 822 message: {e}")
    
    def parse_string(self, data: str) -> EmailMessage:
        """Parse RFC 822 message from string."""
        try:
            return self._string_parser.parsestr(data)
        except Exception as e:
            raise ParsingError(f"Failed to parse RFC 822 message: {e}")
    
    def parse_file(self, path: Path) -> EmailMessage:
        """Parse RFC 822 message from file."""
        try:
            with open(path, 'rb') as f:
                return self.parse_bytes(f.read())
        except Exception as e:
            raise ParsingError(f"Failed to read/parse file {path}: {e}")
    
    def calculate_hash(self, msg: EmailMessage) -> str:
        """Calculate SHA-256 hash of message."""
        return hashlib.sha256(msg.as_bytes()).hexdigest()
    
    def calculate_file_hash(self, path: Path) -> str:
        """Calculate SHA-256 hash of file."""
        hasher = hashlib.sha256()
        with open(path, 'rb') as f:
            for chunk in iter(lambda: f.read(4096), b''):
                hasher.update(chunk)
        return hasher.hexdigest()
    
    def get_message_tree(self, msg: EmailMessage) -> Dict[str, Any]:
        """Get complete MIME tree structure with all details."""
        tree = {
            'content_type': msg.get_content_type(),
            'content_subtype': msg.get_content_subtype(),
            'is_multipart': msg.is_multipart(),
            'headers': {},
            'body': None,
            'parts': [],
            'disposition': msg.get_content_disposition(),
            'filename': msg.get_filename(),
            'charset': msg.get_content_charset(),
            'content_id': msg.get('Content-ID', '').strip('<>'),
        }
        
        # Extract all headers
        for key, value in msg.items():
            tree['headers'][key] = value
        
        # Extract body if not multipart
        if not msg.is_multipart():
            if msg.get_content_type() in ['text/plain', 'text/html']:
                try:
                    tree['body'] = msg.get_content()
                except Exception:
                    tree['body'] = None
            else:
                try:
                    tree['body'] = msg.get_payload(decode=True)
                except Exception:
                    tree['body'] = None
        
        # Recursively process parts
        if msg.is_multipart():
            for part in msg.iter_parts():
                tree['parts'].append(self.get_message_tree(part))
        
        return tree
    
    def get_all_body_parts(self, msg: EmailMessage) -> List[MIMEPart]:
        """Get all body parts (text/plain and text/html)."""
        body_parts = []
        
        def _walk(part):
            if part.is_multipart():
                for sub_part in part.iter_parts():
                    _walk(sub_part)
            else:
                content_type = part.get_content_type()
                disposition = part.get_content_disposition()
                filename = part.get_filename()
                
                # Skip attachments and inline images
                if disposition == 'attachment' or (filename and disposition != 'inline'):
                    return
                if content_type.startswith('image/') and disposition == 'inline':
                    return
                
                if content_type in ['text/plain', 'text/html']:
                    body_parts.append(part)
        
        _walk(msg)
        return body_parts
    
    def get_attachments(self, msg: EmailMessage) -> List[MIMEPart]:
        """Get all attachment parts."""
        attachments = []
        
        def _walk(part):
            if part.is_multipart():
                for sub_part in part.iter_parts():
                    _walk(sub_part)
            else:
                disposition = part.get_content_disposition()
                filename = part.get_filename()
                if disposition == 'attachment' or (filename and disposition != 'inline'):
                    attachments.append(part)
        
        _walk(msg)
        return attachments
    
    def get_inline_images(self, msg: EmailMessage) -> List[MIMEPart]:
        """Get all inline image parts."""
        images = []
        
        def _walk(part):
            if part.is_multipart():
                for sub_part in part.iter_parts():
                    _walk(sub_part)
            else:
                content_type = part.get_content_type()
                disposition = part.get_content_disposition()
                if content_type.startswith('image/') and disposition == 'inline':
                    images.append(part)
        
        _walk(msg)
        return images
    
    def get_nested_messages(self, msg: EmailMessage) -> List[EmailMessage]:
        """Get all nested message/rfc822 parts."""
        nested = []
        
        def _walk(part):
            if part.is_multipart():
                for sub_part in part.iter_parts():
                    if sub_part.get_content_type() == 'message/rfc822':
                        payload = sub_part.get_payload()
                        if isinstance(payload, list) and payload:
                            nested.append(payload[0])
                            _walk(payload[0])
                        elif isinstance(payload, EmailMessage):
                            nested.append(payload)
                            _walk(payload)
                    else:
                        _walk(sub_part)
        
        _walk(msg)
        return nested
    
    def get_all_headers(self, msg: EmailMessage) -> Dict[str, List[str]]:
        """Get all headers including duplicates."""
        headers = {}
        for key, value in msg.raw_items():
            if key not in headers:
                headers[key] = []
            headers[key].append(value)
        return headers
    
    def get_message_ids(self, msg: EmailMessage) -> Set[str]:
        """Get all Message-ID and related IDs."""
        ids = set()
        
        def _extract_ids(message):
            for header in ['Message-ID', 'In-Reply-To', 'References']:
                if header in message:
                    # Parse multiple IDs
                    import re
                    ids_found = re.findall(r'<[^>]+>', message[header])
                    ids.update(ids_found)
            
            if message.is_multipart():
                for part in message.iter_parts():
                    if part.get_content_type() == 'message/rfc822':
                        payload = part.get_payload()
                        if isinstance(payload, list) and payload:
                            _extract_ids(payload[0])
                        elif isinstance(payload, EmailMessage):
                            _extract_ids(payload)
        
        _extract_ids(msg)
        return ids


